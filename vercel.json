{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/src/pages/index.html" },
    { "source": "/ministries", "destination": "/src/pages/ministries.html" },
    { "source": "/ministry", "destination": "/src/pages/ministry.html" },
    { "source": "/sermons", "destination": "/src/pages/sermons.html" },
    { "source": "/fellowships", "destination": "/src/pages/fellowships.html" },
    { "source": "/fellowship", "destination": "/src/pages/fellowship.html" },
    { "source": "/shop", "destination": "/src/pages/shop.html" }
  ],
  "headers": [
    {
      "source": "/src/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
