<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Church Gallery | ACK St. Phillips Roadblock</title>

    <meta
        name="description"
        content="Explore memorable moments, worship services, fellowship and events at ACK St. Phillips Roadblock Church, Eldoret."
    >

    <link rel="stylesheet" href="/css/output.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    >
</head>

<body class="bg-ack-cream">

    <%- include('partials/header') %>

    <!-- HERO -->
    <section class="relative min-h-[65vh] flex items-center justify-center overflow-hidden">

        <img
            src="https://images.pixieset.com/84914978/ad3d085a3075a2092e93338036ce96bd-cover.JPG"
            alt="ACK St. Phillips Roadblock church gathering"
            class="absolute inset-0 w-full h-full object-cover"
        >

        <div class="absolute inset-0 bg-ack-purple/75"></div>

        <div class="relative z-10 text-center px-6 max-w-3xl">

            <span class="text-ack-gold uppercase tracking-[0.3em] text-sm font-semibold">
                Moments & Memories
            </span>

            <h1 class="font-display text-white text-4xl md:text-6xl font-bold mt-5">
                Life at St. Phillips
            </h1>

            <p class="text-white/85 mt-6 text-lg leading-relaxed">
                A collection of moments that capture our faith,
                fellowship, worship and the beautiful community
                we share together.
            </p>

            <a
                href="https://capturepoint.pixieset.com/stphilipshighlights/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 mt-9 px-8 py-4 bg-ack-gold text-ack-purple font-semibold rounded-full hover:bg-white transition"
            >
                Explore Full Gallery
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>

        </div>
    </section>


    <!-- INTRODUCTION -->
    <section class="py-20 px-6">

        <div class="max-w-4xl mx-auto text-center">

            <span class="text-ack-purple uppercase tracking-widest text-sm font-semibold">
                Our Church, Our Story
            </span>

            <h2 class="font-display text-3xl md:text-4xl text-ack-purple mt-4">
                Every Moment Tells a Story
            </h2>

            <p class="text-gray-600 leading-relaxed mt-6">
                From moments of worship and prayer to fellowship,
                community outreach and special celebrations,
                every gathering reminds us of God's goodness
                and the strength of our church family.
            </p>

            <div class="w-20 h-1 bg-ack-gold mx-auto mt-8"></div>

        </div>

    </section>


    <!-- FEATURED COLLECTION -->
    <section class="pb-24 px-6">

        <div class="max-w-6xl mx-auto">

            <div class="grid md:grid-cols-2 gap-12 items-center">

                <div class="relative group overflow-hidden rounded-2xl shadow-xl">

                    <img
                        src="https://images.pixieset.com/84914978/ad3d085a3075a2092e93338036ce96bd-cover.JPG"
                        alt="St. Phillips church highlights"
                        class="w-full h-[350px] md:h-[450px] object-cover group-hover:scale-105 transition duration-700"
                    >

                    <div class="absolute inset-0 bg-gradient-to-t from-ack-purple/70 to-transparent"></div>

                    <div class="absolute bottom-6 left-6 text-white">
                        <span class="text-ack-gold text-sm uppercase tracking-widest">
                            Featured Collection
                        </span>

                        <h3 class="font-display text-2xl font-bold mt-2">
                            St. Phillips Highlights
                        </h3>
                    </div>

                </div>


                <div>

                    <span class="text-ack-purple uppercase tracking-widest text-sm font-semibold">
                        Capturing Our Journey
                    </span>

                    <h2 class="font-display text-3xl md:text-4xl text-ack-purple mt-4">
                        Celebrating Faith, Fellowship & Community
                    </h2>

                    <p class="text-gray-600 leading-relaxed mt-6">
                        Our photographs preserve the special moments
                        that make our church family unique. Explore
                        memories from our gatherings and celebrations.
                    </p>

                    <a
                        href="https://capturepoint.pixieset.com/stphilipshighlights/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-3 mt-8 text-ack-purple font-semibold border-b-2 border-ack-gold pb-2 hover:text-ack-gold transition"
                    >
                        View All Photographs
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                    <p class="text-gray-500 text-sm mt-5">
                        Photography by CAPTUREPOINT
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="bg-ack-purple py-20 px-6 text-center">

        <div class="max-w-3xl mx-auto">

            <i class="fa-solid fa-camera text-ack-gold text-4xl"></i>

            <h2 class="font-display text-white text-3xl md:text-4xl mt-6">
                Be Part of Our Story
            </h2>

            <p class="text-white/75 mt-5 leading-relaxed">
                Join us in worship, fellowship and service as we
                continue creating meaningful memories together.
            </p>

            <a
                href="/contact"
                class="inline-block mt-8 bg-ack-gold text-ack-purple px-8 py-4 rounded-full font-semibold hover:bg-white transition"
            >
                Get in Touch
            </a>

        </div>

    </section>


    <%- include('partials/footer') %>

</body>
</html>