<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="shortcut icon" href="/images/ack-logo.svg" type="image/x-icon">
    <title>
        <%= title %>
    </title>
    <style>
        html{
            scroll-behavior: smooth;
        }
    </style>
</head>

<body>
    <%- include('partials/header') %>

        <main>

            <!-- Hero Section -->
            <section class="relative min-h-[420px] flex items-center overflow-hidden">

                <img src="/images/church.webp" alt="ACK St. Phillips Roadblock Church"
                    class="absolute inset-0 w-full h-full object-cover">

                <div
                    class="absolute inset-0 bg-gradient-to-r from-ack-purple-dark/95 via-ack-purple-dark/75 to-ack-purple-dark/30">
                </div>

                <div class="relative max-w-7xl mx-auto w-full px-5 sm:px-8 py-24">

                    <div class="max-w-2xl">

                        <span
                            class="inline-flex items-center gap-3 text-ack-gold text-xs font-bold uppercase tracking-[0.25em]">
                            <span class="w-10 h-px bg-ack-gold"></span>
                            Worship With Us
                        </span>

                        <h1
                            class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-white mt-6 leading-tight">
                            A Place to Worship,
                            <span class="text-ack-gold">Grow & Belong.</span>
                        </h1>

                        <p class="text-white/80 mt-6 text-base sm:text-lg leading-relaxed max-w-xl">
                            Join us at ACK St. Phillips Roadblock as we come together
                            in worship, fellowship and the love of Christ.
                            There is a place for everyone.
                        </p>

                        <div class="flex flex-wrap gap-4 mt-8">

                            <a href="#service-times"
                                class="inline-flex items-center gap-3 bg-ack-gold text-ack-purple-dark px-7 py-3.5 rounded-lg font-bold text-sm hover:bg-white transition">
                                Explore Our Services
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>

                            <a href="/contact"
                                class="inline-flex items-center gap-2 border border-white/40 text-white px-7 py-3.5 rounded-lg font-semibold text-sm hover:bg-white hover:text-black transition duration-300">
                                Plan Your Visit
                            </a>

                        </div>

                    </div>
                </div>
            </section>


            <!-- Introduction -->
            <section class="bg-ack-cream py-16 md:py-20">

                <div class="max-w-4xl mx-auto px-5 text-center">

                    <span class="text-ack-purple text-xs font-bold uppercase tracking-[0.25em]">
                        Gather in His Name
                    </span>

                    <h2 class="font-display text-3xl md:text-4xl font-bold text-ack-purple-dark mt-4">
                        Worship Is at the Heart of Our Parish
                    </h2>

                    <p class="text-gray-600 mt-5 leading-relaxed text-sm sm:text-base">
                        We believe that worship brings us closer to God and to one another.
                        Through prayer, praise, Holy Communion, teaching and fellowship,
                        we grow in faith and discover how to live out the Gospel every day.
                        We warmly welcome you and your family to worship with us.
                    </p>

                </div>

            </section>


            <!-- Service Times -->
            <section id="service-times" class="bg-white py-20 md:py-24">

                <div class="max-w-7xl mx-auto px-5 sm:px-8">

                    <div class="text-center mb-14">

                        <span class="text-ack-purple text-xs font-bold uppercase tracking-[0.25em]">
                            Join Us Every Sunday
                        </span>

                        <h2 class="font-display text-3xl md:text-4xl font-bold text-ack-purple-dark mt-4">
                            Our Worship Services
                        </h2>

                        <p class="text-gray-500 mt-4 max-w-2xl mx-auto text-sm sm:text-base">
                            Find a service that works for you. We look forward to
                            worshipping together as one parish family.
                        </p>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">


                        <!-- English Service -->
                        <article
                            class="group rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">

                            <div class="relative h-56 overflow-hidden">

                                <img src="/images/DSC_1024.JPG" alt="Sunday English worship service" loading="lazy"
                                    class="w-full h-full object-cover group-hover:scale-105 transition duration-700">

                                <div class="absolute inset-0 bg-gradient-to-t from-ack-purple-dark/70 to-transparent">
                                </div>

                                <span
                                    class="absolute bottom-5 left-5 bg-ack-gold text-ack-purple-dark px-4 py-2 rounded-full text-xs font-bold">
                                    Every Sunday
                                </span>

                            </div>

                            <div class="p-7">

                                <div class="flex items-center gap-3 text-ack-purple mb-4">
                                    <i class="fa-solid fa-church text-xl"></i>
                                    <span class="text-xs font-bold uppercase tracking-wider">
                                        English Congregation
                                    </span>
                                </div>

                                <h3 class="font-display text-2xl font-bold text-ack-purple-dark">
                                    English Service
                                </h3>

                                <p class="text-gray-500 text-sm leading-relaxed mt-3">
                                    Come together for worship, prayer, Biblical teaching
                                    and Holy Communion as we grow in Christ.
                                </p>

                                <div class="border-t border-gray-100 mt-6 pt-5 flex items-center justify-between">

                                    <div>
                                        <p class="text-xs text-gray-400 uppercase font-semibold">Service Time</p>
                                        <p class="text-ack-purple-dark font-bold mt-1">
                                            8:00 AM – 9:00 AM
                                        </p>
                                    </div>

                                    <i class="fa-regular fa-clock text-ack-gold text-xl"></i>

                                </div>

                            </div>

                        </article>


                        <!-- Kiswahili Service -->
                        <article
                            class="group rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">

                            <div class="relative h-56 overflow-hidden">

                                <img src="/images/41654.jpg" alt="Church worship gathering" loading="lazy"
                                    class="w-full h-full object-cover group-hover:scale-105 transition duration-700">

                                <div class="absolute inset-0 bg-gradient-to-t from-ack-purple-dark/70 to-transparent">
                                </div>

                                <span
                                    class="absolute bottom-5 left-5 bg-ack-gold text-ack-purple-dark px-4 py-2 rounded-full text-xs font-bold">
                                    Every Sunday
                                </span>

                            </div>

                            <div class="p-7">

                                <div class="flex items-center gap-3 text-ack-purple mb-4">
                                    <i class="fa-solid fa-hands-praying text-xl"></i>
                                    <span class="text-xs font-bold uppercase tracking-wider">
                                        Kiswahili Congregation
                                    </span>
                                </div>

                                <h3 class="font-display text-2xl font-bold text-ack-purple-dark">
                                    Kiswahili Service
                                </h3>

                                <p class="text-gray-500 text-sm leading-relaxed mt-3">
                                    Experience uplifting worship, prayer, fellowship
                                    and the Word of God in Kiswahili.
                                </p>

                                <div class="border-t border-gray-100 mt-6 pt-5 flex items-center justify-between">

                                    <div>
                                        <p class="text-xs text-gray-400 uppercase font-semibold">Service Time</p>
                                        <p class="text-ack-purple-dark font-bold mt-1">
                                            10:00 AM – 12:30 PM
                                        </p>
                                    </div>

                                    <i class="fa-regular fa-clock text-ack-gold text-xl"></i>

                                </div>

                            </div>

                        </article>


                        <!-- Sunday School -->
                        <article
                            class="group rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">

                            <div class="relative h-56 overflow-hidden">

                                <img src="/images/vertical-grayscale-shot-grassy-field-with-blurred-cross.webp"
                                    alt="Sunday School and children's ministry" loading="lazy"
                                    class="w-full h-full object-cover group-hover:scale-105 transition duration-700">

                                <div class="absolute inset-0 bg-gradient-to-t from-ack-purple-dark/70 to-transparent">
                                </div>

                                <span
                                    class="absolute bottom-5 left-5 bg-ack-gold text-ack-purple-dark px-4 py-2 rounded-full text-xs font-bold">
                                    Every Sunday
                                </span>

                            </div>

                            <div class="p-7">

                                <div class="flex items-center gap-3 text-ack-purple mb-4">
                                    <i class="fa-solid fa-children text-xl"></i>
                                    <span class="text-xs font-bold uppercase tracking-wider">
                                        Children & Teens
                                    </span>
                                </div>

                                <h3 class="font-display text-2xl font-bold text-ack-purple-dark">
                                    Sunday School
                                </h3>

                                <p class="text-gray-500 text-sm leading-relaxed mt-3">
                                    We nurture children and teenagers through Biblical
                                    teaching, prayer, friendship and activities that
                                    help them grow in faith.
                                </p>

                                <div class="border-t border-gray-100 mt-6 pt-5 flex items-center justify-between">

                                    <div>
                                        <p class="text-xs text-gray-400 uppercase font-semibold">Gathering Time</p>
                                        <p class="text-ack-purple-dark font-bold mt-1">
                                            10:00 AM
                                        </p>
                                    </div>

                                    <i class="fa-regular fa-clock text-ack-gold text-xl"></i>

                                </div>

                            </div>

                        </article>

                    </div>

                </div>

            </section>


            <!-- Holy Communion & Morning Prayer -->
            <section class="bg-ack-cream py-20">

                <div class="max-w-7xl mx-auto px-5 sm:px-8">

                    <div class="text-center mb-12">

                        <span class="text-ack-purple text-xs font-bold uppercase tracking-[0.25em]">
                            Beyond Sunday Worship
                        </span>

                        <h2 class="font-display text-3xl md:text-4xl font-bold text-ack-purple-dark mt-4">
                            Grow Through Prayer & Fellowship
                        </h2>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-7">

                        <!-- Holy Communion -->
                        <article class="bg-white rounded-2xl p-8 md:p-10 shadow-sm flex flex-col sm:flex-row gap-6">

                            <div
                                class="h-16 w-16 shrink-0 rounded-2xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                <i class="fa-solid fa-wine-glass text-2xl"></i>
                            </div>

                            <div>

                                <span class="text-ack-gold text-xs font-bold uppercase tracking-wider">
                                    The Sacrament
                                </span>

                                <h3 class="font-display text-2xl font-bold text-ack-purple-dark mt-2">
                                    Holy Communion
                                </h3>

                                <p class="text-gray-500 text-sm leading-relaxed mt-3">
                                    We gather at the Lord's Table to remember Christ's
                                    sacrifice and celebrate God's grace through the
                                    sacrament of Holy Communion.
                                </p>

                                <p class="mt-5 text-ack-purple font-semibold text-sm">
                                    <i class="fa-regular fa-clock mr-2"></i>
                                    Sundays · 8:00 AM English Service
                                </p>

                            </div>

                        </article>


                        <!-- Morning Prayer -->
                        <article class="bg-white rounded-2xl p-8 md:p-10 shadow-sm flex flex-col sm:flex-row gap-6">

                            <div
                                class="h-16 w-16 shrink-0 rounded-2xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                <i class="fa-solid fa-hands-praying text-2xl"></i>
                            </div>

                            <div>

                                <span class="text-ack-gold text-xs font-bold uppercase tracking-wider">
                                    Daily Fellowship
                                </span>

                                <h3 class="font-display text-2xl font-bold text-ack-purple-dark mt-2">
                                    Morning Prayer
                                </h3>

                                <p class="text-gray-500 text-sm leading-relaxed mt-3">
                                    Begin your day in God's presence through prayer,
                                    reflection and fellowship with other members
                                    of our parish community.
                                </p>

                                <p class="mt-5 text-ack-purple font-semibold text-sm">
                                    <i class="fa-regular fa-clock mr-2"></i>
                                    Weekdays · 6:00 AM – 7:00 AM
                                </p>

                            </div>

                        </article>

                    </div>

                </div>

            </section>


            <!-- First Time Visitors -->
            <!-- <section class="relative overflow-hidden bg-ack-purple py-20 md:py-24">

                <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></div>
                <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-ack-gold/10 blur-3xl"></div>

                <div class="relative max-w-4xl mx-auto px-5 text-center">

                    <i class="fa-solid fa-heart text-ack-gold text-3xl"></i>

                    <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mt-6">
                        Your Place Is Here.
                    </h2>

                    <p class="text-white/75 mt-5 leading-relaxed max-w-2xl mx-auto">
                        Whether you are visiting for the first time, returning to church
                        or looking for a place to grow in faith, you are welcome at
                        ACK St. Phillips Roadblock. Come as you are.
                    </p>

                    <div class="flex flex-wrap justify-center gap-4 mt-9">

                        <a href="/contact"
                            class="bg-ack-gold text-ack-purple-dark px-8 py-3.5 rounded-lg font-bold text-sm hover:bg-white transition">
                            Get in Touch
                        </a>

                        <a href="/about"
                            class="border border-white/40 text-white px-8 py-3.5 rounded-lg font-semibold text-sm hover:bg-white hover:text-ack-purple-dark transition">
                            Learn About Us
                        </a>

                    </div>

                </div>

            </section> -->

        </main>

        <%- include('partials/footer') %>
</body>

</html>