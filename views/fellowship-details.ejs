<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="<%= fellowship.description %> Join the <%= fellowship.estate %> Estate Fellowship at ACK St. Phillips Roadblock Church.">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

    <link rel="stylesheet" href="/css/output.css">
    <link rel="shortcut icon" href="/images/ack-logo.svg" type="image/x-icon">

    <title><%= fellowship.estate %> Fellowship | ACK St. Phillips Roadblock</title>
</head>

<body class="bg-ack-cream text-gray-900 antialiased">

    <%- include('partials/header.ejs') %>

    <main>

        <!-- HERO -->
        <section class="relative min-h-[440px] md:min-h-[520px] flex items-end overflow-hidden">

            <img
                src="<%= fellowship.image %>"
                alt="<%= fellowship.estate %> Estate Fellowship"
                class="absolute inset-0 w-full h-full object-cover"
            >

            <div class="absolute inset-0 bg-gradient-to-t from-ack-purple-dark via-ack-purple-dark/70 to-ack-purple-dark/20"></div>

            <div class="relative z-10 max-w-7xl mx-auto px-6 pb-14 pt-32 w-full text-white">

                <a href="/fellowships"
                    class="inline-flex items-center gap-2 text-white/80 hover:text-ack-gold text-sm font-medium transition mb-8">
                    <i class="fa-solid fa-arrow-left"></i>
                    All Fellowships
                </a>

                <div class="flex flex-wrap items-center gap-3 mb-5">

                    <span class="<%= fellowship.badgeClass %> text-xs px-4 py-2 rounded-full font-semibold">
                        <%= fellowship.tag %>
                    </span>

                    <span class="bg-white/15 backdrop-blur-md text-white text-xs px-4 py-2 rounded-full border border-white/20">
                        <i class="fa-solid fa-location-dot mr-1 text-ack-gold"></i>
                        <%= fellowship.estate %>
                    </span>

                </div>

                <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight max-w-3xl">
                    <%= fellowship.estate %> Estate Fellowship
                </h1>

                <p class="text-white/80 mt-5 text-base md:text-lg max-w-2xl leading-relaxed">
                    Growing together in faith, building meaningful relationships
                    and serving God within our community.
                </p>

            </div>
        </section>


        <!-- MAIN CONTENT -->
        <section class="max-w-7xl mx-auto px-6 py-12 md:py-16">

            <div class="grid lg:grid-cols-3 gap-10 lg:gap-14">

                <!-- LEFT CONTENT -->
                <div class="lg:col-span-2 space-y-12">

                    <!-- ABOUT -->
                    <section>

                        <div class="flex items-center gap-3 mb-5">

                            <span class="w-10 h-10 rounded-xl bg-ack-purple/10 flex items-center justify-center text-ack-purple">
                                <i class="fa-solid fa-users"></i>
                            </span>

                            <div>
                                <p class="text-xs font-bold text-ack-gold uppercase tracking-widest">
                                    Get to know us
                                </p>

                                <h2 class="text-2xl font-bold text-ack-purple-dark">
                                    About this fellowship
                                </h2>
                            </div>

                        </div>

                        <p class="text-gray-700 leading-relaxed text-base md:text-lg">
                            <%= fellowship.description %>
                        </p>

                        <p class="text-gray-600 mt-4 leading-relaxed">
                            <%= fellowship.membership %>
                        </p>

                    </section>


                    <!-- THIS WEEK'S MEETING -->
                    <section class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

                        <div class="bg-ack-purple px-6 py-5 text-white">

                            <div class="flex items-center gap-3">

                                <span class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center text-ack-gold">
                                    <i class="fa-solid fa-calendar-week text-lg"></i>
                                </span>

                                <div>
                                    <p class="text-xs uppercase tracking-widest text-white/70 font-semibold">
                                        Stay connected
                                    </p>

                                    <h2 class="font-bold text-lg">
                                        This week's meeting
                                    </h2>
                                </div>

                            </div>

                        </div>

                        <div class="p-6 grid sm:grid-cols-2 gap-6">

                            <div class="flex gap-4">

                                <span class="w-11 h-11 shrink-0 rounded-xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                    <i class="fa-regular fa-calendar"></i>
                                </span>

                                <div>
                                    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">
                                        Meeting day
                                    </p>

                                    <p class="font-bold text-gray-900 mt-1">
                                        <%= fellowship.day %>
                                    </p>
                                </div>

                            </div>

                            <div class="flex gap-4">

                                <span class="w-11 h-11 shrink-0 rounded-xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                    <i class="fa-regular fa-clock"></i>
                                </span>

                                <div>
                                    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">
                                        Meeting time
                                    </p>

                                    <p class="font-bold text-gray-900 mt-1">
                                        <%= fellowship.time %>
                                    </p>
                                </div>

                            </div>

                            <div class="flex gap-4 sm:col-span-2">

                                <span class="w-11 h-11 shrink-0 rounded-xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                    <i class="fa-solid fa-location-dot"></i>
                                </span>

                                <div>
                                    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">
                                        Meeting location
                                    </p>

                                    <p class="font-bold text-gray-900 mt-1">
                                        <%= fellowship.location %>
                                    </p>

                                    <p class="text-sm text-gray-500 mt-1">
                                        <%= fellowship.mapNote %>
                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="px-6 pb-5">
                            <p class="text-xs text-gray-500 italic border-t border-gray-100 pt-4">
                                <i class="fa-solid fa-circle-info text-ack-gold mr-1"></i>
                                Times may vary on public holidays. Please check the parish noticeboard for updates.
                            </p>
                        </div>

                    </section>


                    <!-- ACTIVITIES -->
                    <section>

                        <div class="mb-6">

                            <p class="text-xs font-bold text-ack-gold uppercase tracking-widest">
                                Fellowship life
                            </p>

                            <h2 class="text-2xl font-bold text-ack-purple-dark mt-1">
                                What we do together
                            </h2>

                            <p class="text-sm text-gray-500 mt-2">
                                Our fellowship meetings provide opportunities to grow spiritually and support one another.
                            </p>

                        </div>

                        <div class="grid sm:grid-cols-2 gap-4">

                            <% if (fellowship.activities && fellowship.activities.length) { %>

                                <% fellowship.activities.forEach((item) => { %>

                                    <div class="flex gap-3 bg-white p-4 rounded-xl border border-gray-200">

                                        <span class="w-8 h-8 shrink-0 rounded-lg bg-green-50 text-green-600 flex items-center justify-center">
                                            <i class="fa-solid fa-check"></i>
                                        </span>

                                        <p class="text-sm text-gray-700 leading-relaxed">
                                            <%= item %>
                                        </p>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <p class="text-sm text-gray-500">
                                    Fellowship activities will be updated soon.
                                </p>

                            <% } %>

                        </div>

                    </section>


                    <!-- WEEKLY SCHEDULE -->
                    <% if (fellowship.schedule && fellowship.schedule.length) { %>

                        <section>

                            <div class="mb-6">

                                <p class="text-xs font-bold text-ack-gold uppercase tracking-widest">
                                    Plan your week
                                </p>

                                <h2 class="text-2xl font-bold text-ack-purple-dark mt-1">
                                    Weekly schedule
                                </h2>

                            </div>

                            <div class="space-y-3">

                                <% fellowship.schedule.forEach((s) => { %>

                                    <div class="bg-white border border-gray-200 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center gap-4">

                                        <div class="w-14 h-14 shrink-0 rounded-xl bg-ack-purple/10 flex flex-col items-center justify-center text-ack-purple">
                                            <i class="fa-regular fa-calendar text-lg"></i>
                                        </div>

                                        <div class="flex-1">

                                            <p class="text-xs text-ack-purple font-bold uppercase tracking-wide">
                                                <%= s.day %>
                                            </p>

                                            <p class="font-bold text-gray-900 mt-1">
                                                <%= s.activity %>
                                            </p>

                                        </div>

                                        <span class="inline-flex items-center gap-2 text-sm text-gray-600 bg-gray-50 rounded-lg px-4 py-2">
                                            <i class="fa-regular fa-clock text-ack-gold"></i>
                                            <%= s.time %>
                                        </span>

                                    </div>

                                <% }) %>

                            </div>

                            <% if (fellowship.note) { %>

                                <p class="text-sm text-gray-500 mt-4 leading-relaxed">
                                    <i class="fa-solid fa-circle-info text-ack-gold mr-1"></i>
                                    <%= fellowship.note %>
                                </p>

                            <% } %>

                        </section>

                    <% } %>


                    <!-- LEADERSHIP -->
                    <% if (fellowship.leadership && fellowship.leadership.length) { %>

                        <section>

                            <div class="mb-6">

                                <p class="text-xs font-bold text-ack-gold uppercase tracking-widest">
                                    Our team
                                </p>

                                <h2 class="text-2xl font-bold text-ack-purple-dark mt-1">
                                    Fellowship leadership
                                </h2>

                                <p class="text-sm text-gray-500 mt-2">
                                    Meet the people helping guide and coordinate this fellowship.
                                </p>

                            </div>

                            <div class="grid sm:grid-cols-2 gap-4">

                                <% fellowship.leadership.forEach((t) => { %>

                                    <div class="bg-white border border-gray-200 rounded-xl p-5">

                                        <div class="flex items-center gap-3">

                                            <span class="w-11 h-11 rounded-full bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                                <i class="fa-solid fa-user"></i>
                                            </span>

                                            <div>
                                                <p class="text-xs font-bold text-ack-purple uppercase tracking-wide">
                                                    <%= t.role %>
                                                </p>

                                                <h3 class="font-bold text-gray-900 mt-1">
                                                    <%= t.name %>
                                                </h3>
                                            </div>

                                        </div>

                                        <% if (t.phone) { %>

                                            <a href="tel:<%= t.phone.replace(/\s/g, '') %>"
                                                class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-ack-purple mt-4 transition">

                                                <i class="fa-solid fa-phone text-ack-gold"></i>
                                                <%= t.phone %>

                                            </a>

                                        <% } %>

                                    </div>

                                <% }) %>

                            </div>

                        </section>

                    <% } %>


                    <!-- GIVING -->
                    <% if (fellowship.payments && fellowship.payments.length) { %>

                        <section>

                            <div class="mb-6">

                                <p class="text-xs font-bold text-ack-gold uppercase tracking-widest">
                                    Support our mission
                                </p>

                                <h2 class="text-2xl font-bold text-ack-purple-dark mt-1">
                                    Giving &amp; Payments
                                </h2>

                                <p class="text-sm text-gray-500 mt-2 leading-relaxed">
                                    Support this fellowship's programmes and activities through the available giving channels.
                                </p>

                            </div>

                            <div class="grid sm:grid-cols-2 gap-4">

                                <% fellowship.payments.forEach((p) => { %>

                                    <div class="bg-white border border-gray-200 rounded-2xl p-6">

                                        <div class="flex items-center justify-between gap-3">

                                            <h3 class="font-bold text-ack-purple-dark">
                                                <%= p.title %>
                                            </h3>

                                            <span class="w-10 h-10 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                                                <i class="fa-solid fa-hand-holding-dollar"></i>
                                            </span>

                                        </div>

                                        <% if (p.amount) { %>

                                            <p class="text-2xl font-bold text-gray-900 mt-4">
                                                <%= p.amount %>
                                            </p>

                                        <% } %>

                                        <% if (p.mpesa) { %>
                                            <div class="mt-5 bg-green-50 border border-green-100 rounded-xl p-4 flex items-center justify-between">

                                                <p class="text-xs font-bold text-green-700 uppercase tracking-wide">
                                                    <i class="fa-solid fa-mobile-screen mr-1"></i>
                                                    Paybil No
                                                </p>

                                                <p class="text-lg font-bold text-gray-900 mt-1">
                                                    700201
                                                </p>
                                            </div>

                                            <div class="mt-2 bg-green-50 border border-green-100 rounded-xl p-4 flex items-center justify-between">

                                                <p class="text-xs font-bold text-green-700 uppercase tracking-wide">
                                                    <i class="fa-solid fa-mobile-screen mr-1"></i>
                                                    Account No
                                                </p>

                                                <p class="text-lg font-bold text-gray-900 mt-1">
                                                    <%= p.mpesa %>
                                                </p>
                                            </div>
                                            

                                        <% } %>

                                        <% if (p.notes) { %>

                                            <p class="text-xs text-gray-500 mt-4 leading-relaxed">
                                                <%= p.notes %>
                                            </p>

                                        <% } %>

                                    </div>

                                <% }) %>

                            </div>

                            <div class="mt-5 bg-ack-purple/5 border border-ack-purple/10 rounded-xl p-4 flex gap-3">

                                <i class="fa-solid fa-circle-info text-ack-purple mt-1"></i>

                                <p class="text-sm text-gray-600 leading-relaxed">
                                    When making a contribution, include your name and the fellowship or ministry
                                    in the M-Pesa message for proper identification.
                                </p>

                            </div>

                        </section>

                    <% } %>


                    <!-- WHAT TO BRING / JOIN -->
                    <section class="grid sm:grid-cols-2 gap-5">

                        <div class="bg-white border border-gray-200 rounded-2xl p-6">

                            <span class="w-11 h-11 rounded-xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                <i class="fa-solid fa-bag-shopping"></i>
                            </span>

                            <h3 class="font-bold text-ack-purple-dark mt-4">
                                What to bring
                            </h3>

                            <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                                <%= fellowship.bring %>
                            </p>

                        </div>

                        <div class="bg-ack-purple rounded-2xl p-6 text-white">

                            <span class="w-11 h-11 rounded-xl bg-white/10 text-ack-gold flex items-center justify-center">
                                <i class="fa-solid fa-handshake"></i>
                            </span>

                            <h3 class="font-bold text-ack-gold mt-4">
                                How to join
                            </h3>

                            <p class="text-sm text-white/80 mt-2 leading-relaxed">
                                <%= fellowship.getInvolved %>
                            </p>

                        </div>

                    </section>

                </div>


                <!-- RIGHT SIDEBAR -->
                <aside class="space-y-6 lg:sticky lg:top-24 h-fit">

                    <!-- MEETING DETAILS -->
                    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">

                        <div class="flex items-center gap-3 mb-6">

                            <span class="w-10 h-10 rounded-xl bg-ack-purple/10 text-ack-purple flex items-center justify-center">
                                <i class="fa-solid fa-circle-info"></i>
                            </span>

                            <h2 class="font-bold text-ack-purple-dark text-lg">
                                Meeting details
                            </h2>

                        </div>

                        <% if (meeting && meeting.length) { %>

                            <ul class="space-y-5">

                                <% meeting.forEach((m) => { %>

                                    <li class="flex gap-3">

                                        <i class="fa-solid fa-<%= m.icon %> text-ack-gold mt-1"></i>

                                        <div>

                                            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">
                                                <%= m.label %>
                                            </p>

                                            <div class="text-sm text-gray-700 mt-1">

                                                <% if (m.html) { %>
                                                    <%- m.html %>
                                                <% } else { %>
                                                    <%= m.value %>
                                                <% } %>

                                            </div>

                                        </div>

                                    </li>

                                <% }) %>

                            </ul>

                        <% } else { %>

                            <p class="text-sm text-gray-500">
                                Meeting information will be updated soon.
                            </p>

                        <% } %>

                    </div>


                    <!-- JOIN CTA -->
                    <div class="bg-ack-purple rounded-2xl p-6 text-white relative overflow-hidden">

                        <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-white/5"></div>

                        <div class="relative">

                            <span class="w-12 h-12 rounded-xl bg-white/10 text-ack-gold flex items-center justify-center text-xl">
                                <i class="fa-solid fa-people-group"></i>
                            </span>

                            <h2 class="font-bold text-xl mt-5">
                                We'd love to meet you!
                            </h2>

                            <p class="text-sm text-white/75 mt-3 leading-relaxed">
                                Come and experience fellowship, encouragement and spiritual growth with us.
                                You are welcome.
                            </p>

                            <a href="/contact"
                                class="inline-flex items-center justify-center gap-2 w-full mt-6 bg-ack-gold text-ack-purple-dark font-bold text-sm py-3 px-5 rounded-xl hover:bg-white transition">

                                Get in touch
                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>


                    <!-- PARISH LOCATION -->
                    <div class="bg-white rounded-2xl border border-gray-200 p-6">

                        <h2 class="font-bold text-ack-purple-dark">
                            Our parish
                        </h2>

                        <p class="text-sm text-gray-600 mt-3 leading-relaxed">
                            ACK St. Phillips Roadblock Church,
                            Along Uganda Road, Behind Rubis Petrol Station,
                            Roadblock, Eldoret.
                        </p>

                        <a href="/contact"
                            class="inline-flex items-center gap-2 text-sm text-ack-purple font-bold mt-4 hover:text-ack-gold transition">

                            Contact the parish
                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </aside>

            </div>

        </section>

    </main>

    <%- include('partials/footer.ejs') %>

</body>
</html>