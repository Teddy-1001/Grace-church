<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="<%= fellowship.description %> Join <%= fellowship.title %> at ACK St. Phillips Roadblock Church.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="shortcut icon" href="/images/ack-logo.svg" type="image/x-icon">
    <title><%= fellowship.title %> | ACK St. Phillips Roadblock</title>
</head>

<body class="bg-ack-cream text-gray-900 antialiased">
    <%- include('partials/header.ejs') %>

    <main>
        <section class="relative isolate min-h-[420px] overflow-hidden flex items-end">
            <img src="<%= fellowship.image %>" alt="<%= fellowship.title %>"
                class="absolute inset-0 -z-20 h-full w-full object-cover">
            <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ack-purple-dark/95 via-ack-purple-dark/70 to-ack-purple-dark/20"></div>
            <div class="mx-auto w-full max-w-7xl px-6 pb-12 pt-32 text-white">
                <a href="/fellowships"
                    class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-white/75 transition hover:text-ack-gold">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    All fellowships
                </a>
                <div class="mb-4 flex flex-wrap items-center gap-3">
                    <span class="<%= fellowship.badgeClass %> rounded-full px-3 py-1.5 text-xs font-semibold">
                        <%= fellowship.tag %>
                    </span>
                    <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs text-white/90 backdrop-blur">
                        <i class="fa-solid fa-location-dot text-ack-gold" aria-hidden="true"></i>
                        <%= fellowship.estate %>
                    </span>
                </div>
                <h1 class="max-w-3xl font-display text-4xl font-bold leading-tight md:text-6xl">
                    <%= fellowship.title %>
                </h1>
                <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/80 md:text-lg">
                    <%= fellowship.description %>
                </p>
            </div>
        </section>

        <section class="border-b border-gray-200 bg-white">
            <div class="mx-auto grid max-w-7xl divide-y divide-gray-100 px-6 py-6 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
                <div class="flex items-start gap-3 py-4 sm:px-6 sm:py-2 sm:first:pl-0">
                    <i class="fa-regular fa-calendar mt-1 text-ack-gold" aria-hidden="true"></i>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">When</p>
                        <p class="mt-1 font-semibold text-ack-purple-dark"><%= fellowship.day %>, <%= fellowship.time %></p>
                    </div>
                </div>
                <div class="flex items-start gap-3 py-4 sm:px-6 sm:py-2">
                    <i class="fa-solid fa-location-dot mt-1 text-ack-gold" aria-hidden="true"></i>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Where</p>
                        <p class="mt-1 font-semibold text-ack-purple-dark"><%= fellowship.location %></p>
                    </div>
                </div>
                <div class="flex items-start gap-3 py-4 sm:px-6 sm:py-2 sm:last:pr-0">
                    <i class="fa-solid fa-users mt-1 text-ack-gold" aria-hidden="true"></i>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Who can join</p>
                        <p class="mt-1 font-semibold text-ack-purple-dark"><%= fellowship.membership %></p>
                    </div>
                </div>
            </div>
        </section>

        <div class="mx-auto grid max-w-7xl gap-12 px-6 py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_320px]">
            <div class="space-y-12">
                <section aria-labelledby="life-heading">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-ack-gold">Life together</p>
                    <h2 id="life-heading" class="mt-2 font-display text-2xl font-bold text-ack-purple-dark md:text-3xl">
                        What we do together
                    </h2>
                    <% if (fellowship.activities && fellowship.activities.length) { %>
                        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                            <% fellowship.activities.forEach((item) => { %>
                                <li class="flex items-start gap-3 rounded-xl border border-gray-200 bg-white p-4">
                                    <i class="fa-solid fa-check mt-1 text-sm text-ack-gold" aria-hidden="true"></i>
                                    <span class="text-sm leading-relaxed text-gray-700"><%= item %></span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>
                </section>

                <% if (fellowship.schedule && fellowship.schedule.length) { %>
                    <section aria-labelledby="schedule-heading">
                        <div class="mb-5">
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-ack-gold">Make time for fellowship</p>
                            <h2 id="schedule-heading" class="mt-2 font-display text-2xl font-bold text-ack-purple-dark md:text-3xl">
                                Gathering times
                            </h2>
                        </div>
                        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white">
                            <% fellowship.schedule.forEach((item, index) => { %>
                                <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between <%= index ? 'border-t border-gray-100' : '' %>">
                                    <div>
                                        <p class="text-xs font-semibold uppercase tracking-wider text-ack-purple"><%= item.day %></p>
                                        <p class="mt-1 font-semibold text-gray-900"><%= item.activity %></p>
                                    </div>
                                    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-ack-cream px-3 py-1.5 text-sm text-gray-700">
                                        <i class="fa-regular fa-clock text-ack-gold" aria-hidden="true"></i>
                                        <%= item.time %>
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                        <% if (fellowship.note) { %>
                            <p class="mt-3 text-sm leading-relaxed text-gray-500"><i class="fa-solid fa-circle-info mr-1 text-ack-gold" aria-hidden="true"></i><%= fellowship.note %></p>
                        <% } %>
                    </section>
                <% } %>

                <% if (fellowship.leadership && fellowship.leadership.length) { %>
                    <section aria-labelledby="leaders-heading">
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-ack-gold">The people who serve</p>
                        <h2 id="leaders-heading" class="mt-2 font-display text-2xl font-bold text-ack-purple-dark md:text-3xl">
                            Fellowship leaders
                        </h2>
                        <div class="mt-5 grid gap-3 sm:grid-cols-2">
                            <% fellowship.leadership.forEach((person) => { %>
                                <div class="flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white p-4">
                                    <div class="flex items-center gap-3">
                                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ack-purple/10 text-ack-purple">
                                            <i class="fa-solid fa-user" aria-hidden="true"></i>
                                        </span>
                                        <div>
                                            <p class="text-xs font-semibold uppercase tracking-wide text-ack-purple"><%= person.role %></p>
                                            <p class="mt-1 font-semibold text-gray-900"><%= person.name %></p>
                                        </div>
                                    </div>
                                    <% if (person.phone) { %>
                                        <a href="tel:<%= person.phone.replace(/\s/g, '') %>"
                                            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ack-cream text-ack-purple transition hover:bg-ack-purple hover:text-white"
                                            aria-label="Call <%= person.name %>">
                                            <i class="fa-solid fa-phone text-xs" aria-hidden="true"></i>
                                        </a>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>

                <% if (fellowship.payments && fellowship.payments.length) { %>
                    <section aria-labelledby="giving-heading">
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-ack-gold">Contribute if you wish</p>
                        <h2 id="giving-heading" class="mt-2 font-display text-2xl font-bold text-ack-purple-dark md:text-3xl">
                            Giving
                        </h2>
                        <div class="mt-5 grid gap-3 sm:grid-cols-2">
                            <% fellowship.payments.forEach((payment) => { %>
                                <div class="rounded-xl border border-gray-200 bg-white p-5">
                                    <h3 class="font-semibold text-ack-purple-dark"><%= payment.title %></h3>
                                    <% if (payment.amount) { %>
                                        <p class="mt-2 text-sm text-gray-700"><%= payment.amount %></p>
                                    <% } %>
                                    <% if (payment.mpesa) { %>
                                        <p class="mt-2 break-words text-sm text-gray-600"><span class="font-medium text-gray-700">Payment details:</span> <%= payment.mpesa %></p>
                                    <% } %>
                                    <% if (payment.notes) { %>
                                        <p class="mt-2 text-xs leading-relaxed text-gray-500"><%= payment.notes %></p>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </section>
                <% } %>
            </div>

            <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start text-gray-900">
                <section class="rounded-2xl bg-ack-purple-dark p-6">
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-ack-gold">You are welcome</p>
                    <h2 class="mt-3 font-display text-2xl font-bold">Come as you are.</h2>
                    <p class="mt-3 text-sm leading-relaxed text-gray-800/75"><%= fellowship.getInvolved %></p>
                    <% if (fellowship.phone) { %>
                        <a href="tel:<%= fellowship.phone.replace(/\s/g, '') %>"
                            class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-ack-gold px-4 py-3 text-sm font-bold text-ack-purple-dark transition hover:bg-ack-gold/70">
                            <i class="fa-solid fa-phone" aria-hidden="true"></i>
                            Call the fellowship
                        </a>
                    <% } %>
                </section>

                <% if (fellowship.bring) { %>
                    <section class="rounded-2xl border border-gray-200 bg-white p-6">
                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-ack-cream text-ack-purple">
                                <i class="fa-solid fa-book-bible" aria-hidden="true"></i>
                            </span>
                            <h2 class="font-bold text-ack-purple-dark">What to bring</h2>
                        </div>
                        <p class="mt-4 text-sm leading-relaxed text-gray-600"><%= fellowship.bring %></p>
                    </section>
                <% } %>

                <section class="rounded-2xl border border-gray-200 bg-white p-6">
                    <h2 class="font-bold text-ack-purple-dark">Need directions?</h2>
                    <% if (fellowship.mapNote) { %>
                        <p class="mt-3 text-sm leading-relaxed text-gray-600"><%= fellowship.mapNote %></p>
                    <% } else { %>
                        <p class="mt-3 text-sm leading-relaxed text-gray-600">Ask the parish team for directions to this week's gathering.</p>
                    <% } %>
                    <a href="https://www.google.com/maps/dir/?api=1&destination=0.549954,35.244222"
                        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-ack-purple transition hover:text-ack-gold"
                        target="_blank" rel="noopener noreferrer">
                        Directions to the parish
                        <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
                    </a>
                </section>
            </aside>
        </div>
    </main>

    <%- include('partials/footer.ejs') %>
</body>

</html>
