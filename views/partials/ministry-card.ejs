<article class="group bg-white rounded-2xl overflow-hidden border border-gray-100 transition-all duration-300">


<!-- Image -->
<div class="relative h-52 overflow-hidden bg-ack-purple/10">

    <img
        src="<%= m.image %>"
        alt="<%= m.title %>"
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    >

    <!-- Category -->
    <span class="absolute top-4 left-4 <%= m.badgeClass %> text-xs font-semibold px-3 py-1.5 rounded-full">
        <%= m.name %>
    </span>

</div>


<!-- Content -->
<div class="p-6">

    <h2 class="font-display text-xl font-bold text-ack-purple-dark group-hover:text-ack-purple transition-colors">
        <%= m.title %>
    </h2>

    <p class="text-gray-500 text-sm mt-3 leading-relaxed line-clamp-3">
        <%= m.description %>
    </p>


    <!-- Meeting Information -->
    <div class="mt-5 pt-4 border-t border-gray-100 flex flex-wrap items-center gap-x-5 gap-y-3 text-xs text-gray-500">

        <% if (m.meetingDay && m.time) { %>

            <span class="inline-flex items-center gap-2">
                <i class="fa-regular fa-clock text-ack-gold"></i>
                <%= m.meetingDay %>, <%= m.time %>
            </span>

        <% } %>

        <% if (m.estate) { %>

            <span class="inline-flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-ack-gold"></i>
                <%= m.estate %>
            </span>

        <% } %>

    </div>


    <!-- Link -->
    <a
        href="/ministry/<%= m.id %>"
        class="mt-6 flex items-center justify-between text-sm font-bold text-ack-purple group/link"
    >
        <span class="group-hover/link:text-ack-gold transition-colors">
            Explore Ministry
        </span>

        <span class="h-9 w-9 rounded-full bg-ack-purple/5 flex items-center justify-center group-hover/link:bg-ack-purple group-hover/link:text-white transition-all">
            <i class="fa-solid fa-arrow-right text-xs"></i>
        </span>
    </a>

</div>


</article>
