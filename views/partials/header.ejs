<!-- HEADER STYLES -->
<style>
  /* Desktop navigation */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 12px 0;
    transition: color 0.25s ease;
    white-space: nowrap;

  }

  .nav-link:hover {
    color: #49306b;
  }

  /* Animated underline */
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 0;
    height: 2px;
    background: #d6ad56;
    border-radius: 10px;
    transition: width 0.25s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-chevron {
    font-size: 9px;
    transition: transform 0.3s ease;
  }

  .group:hover .nav-chevron {
    transform: rotate(180deg);
  }

  /* Desktop dropdown */
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: -15px;
    width: 240px;
    padding: 9px;
    background: white;
    border: 1px solid #f0edf3;
    border-radius: 14px;
    box-shadow: 0 15px 40px rgba(30, 20, 45, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease;
    z-index: 100;
  }

  .group:hover>.nav-dropdown,
  .group:focus-within>.nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 13px;
    border-radius: 9px;
    color: #4b4455;
    font-size: 13px;
    transition: all 0.2s ease;
  }

  .nav-dropdown a i {
    width: 18px;
    text-align: center;
    color: #71578e;
  }

  .nav-dropdown a:hover {
    background: #f5f1f9;
    color: #49306b;
    padding-left: 17px;
  }

  /* Social links */
  .social-link {
    transition: all 0.2s ease;
  }

  .social-link:hover {
    color: #e8c16c;
    transform: translateY(-2px);
  }

  /* Mobile navigation */
  .mobile-nav-link,
  .mobile-dropdown-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 13px 14px;
    border-radius: 10px;
    background: #f8f7fa;
    color: #4b4455;
    transition: all 0.2s ease;
    text-align: left;
  }

  .mobile-nav-link {
    justify-content: flex-start;
    gap: 13px;
  }

  .mobile-nav-link>i,
  .mobile-dropdown-btn span>i {
    width: 18px;
    text-align: center;
    color: #71578e;
  }

  .mobile-nav-link:hover,
  .mobile-dropdown-btn:hover {
    background: #f0ebf5;
    color: #49306b;
  }

  .dropdown-icon {
    font-size: 11px;
    transition: transform 0.3s ease;
  }

  .mobile-dropdown-btn[aria-expanded="true"] .dropdown-icon {
    transform: rotate(180deg);
  }

  .mobile-dropdown-content {
    padding: 7px 0 7px 30px;
  }

  .mobile-dropdown-content a {
    display: block;
    padding: 11px 14px;
    color: #6b6473;
    font-size: 13px;
    border-left: 2px solid #e8dfef;
    transition: all 0.2s ease;
  }

  .mobile-dropdown-content a:hover {
    color: #49306b;
    border-left-color: #d6ad56;
    padding-left: 19px;
  }

  /* Header scroll effect */
  #site-header.scrolled {
    box-shadow: 0 8px 30px rgba(30, 20, 45, 0.08);
    background: rgba(255, 255, 255, 0.97);
  }

  @media (prefers-reduced-motion: reduce) {

    #site-header *,
    #site-header *::before,
    #site-header *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<!-- HEADER JAVASCRIPT -->
<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");

    if (!header || !menuBtn || !mobileMenu) return;

    // Scroll shadow effect
    const handleScroll = () => {
      header.classList.toggle("scrolled", window.scrollY > 20);
    };

    handleScroll();

    window.addEventListener("scroll", handleScroll, {
      passive: true,
    });

    // Close mobile menu
    const closeMenu = () => {
      mobileMenu.classList.add("hidden");

      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "Open menu");

      menuIcon.classList.remove("fa-xmark");
      menuIcon.classList.add("fa-bars-staggered");
    };

    // Toggle mobile menu
    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMenu();
      } else {
        mobileMenu.classList.remove("hidden");

        menuBtn.setAttribute("aria-expanded", "true");
        menuBtn.setAttribute("aria-label", "Close menu");

        menuIcon.classList.remove("fa-bars-staggered");
        menuIcon.classList.add("fa-xmark");
      }
    });

    // Mobile dropdowns
    document.querySelectorAll(".mobile-dropdown-btn").forEach((button) => {
      button.addEventListener("click", () => {
        const content = document.getElementById(
          button.getAttribute("aria-controls"),
        );

        if (!content) return;

        const isOpen = button.getAttribute("aria-expanded") === "true";

        button.setAttribute("aria-expanded", String(!isOpen));

        content.classList.toggle("hidden");
      });
    });

    // Close menu after clicking a navigation link
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Close on Escape
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });

    // Close when switching to desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) {
        closeMenu();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }
</script>