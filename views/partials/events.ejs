<!-- EVENT SLIDER JAVASCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const slider = document.getElementById("event-slider");
        const slides = document.querySelectorAll(".event-slide");
        const dotsContainer = document.getElementById("event-dots");

        const prevButton = document.getElementById("event-prev");
        const nextButton = document.getElementById("event-next");

        const prevMobileButton =
            document.getElementById("event-prev-mobile");

        const nextMobileButton =
            document.getElementById("event-next-mobile");

        const wrapper =
            document.getElementById("event-slider-wrapper");


        // Make sure the slider exists
        if (!slider || !slides.length) {
            return;
        }


        let currentSlide = 0;
        let autoSlide = null;


        /*
        ==========================================
        CREATE DOTS
        ==========================================
        */

        slides.forEach(function (_, index) {

            const dot = document.createElement("button");

            dot.type = "button";

            dot.setAttribute(
                "aria-label",
                "Go to event " + (index + 1)
            );

            dot.className =
                "event-dot w-2.5 h-2.5 rounded-full " +
                "bg-gray-300 transition-all duration-300";


            dot.addEventListener("click", function () {

                goToSlide(index);

                restartAutoSlide();

            });


            dotsContainer.appendChild(dot);

        });


        const dots =
            dotsContainer.querySelectorAll(".event-dot");


        /*
        ==========================================
        GO TO SLIDE
        ==========================================
        */

        function goToSlide(index) {

            if (index >= slides.length) {
                index = 0;
            }

            if (index < 0) {
                index = slides.length - 1;
            }

            currentSlide = index;


            /*
            Move the ENTIRE slider left.
    
            0%   = slide 1
            -100% = slide 2
            -200% = slide 3
            */
            slider.style.transform =
                "translate3d(-" +
                (currentSlide * 100) +
                "%, 0, 0)";


            /*
            Update dots
            */
            dots.forEach(function (dot, dotIndex) {

                if (dotIndex === currentSlide) {

                    dot.classList.remove("bg-gray-300");

                    dot.classList.add(
                        "bg-ack-purple",
                        "w-6"
                    );

                } else {

                    dot.classList.remove(
                        "bg-ack-purple",
                        "w-6"
                    );

                    dot.classList.add(
                        "bg-gray-300"
                    );

                }

            });

        }


        /*
        ==========================================
        NEXT
        ==========================================
        */

        function nextSlide() {

            goToSlide(currentSlide + 1);

        }


        /*
        ==========================================
        PREVIOUS
        ==========================================
        */

        function previousSlide() {

            goToSlide(currentSlide - 1);

        }


        /*
        ==========================================
        DESKTOP BUTTONS
        ==========================================
        */

        if (prevButton) {

            prevButton.addEventListener(
                "click",
                function () {

                    previousSlide();

                    restartAutoSlide();

                }
            );

        }


        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    nextSlide();

                    restartAutoSlide();

                }
            );

        }


        /*
        ==========================================
        MOBILE BUTTONS
        ==========================================
        */

        if (prevMobileButton) {

            prevMobileButton.addEventListener(
                "click",
                function () {

                    previousSlide();

                    restartAutoSlide();

                }
            );

        }


        if (nextMobileButton) {

            nextMobileButton.addEventListener(
                "click",
                function () {

                    nextSlide();

                    restartAutoSlide();

                }
            );

        }


        /*
        ==========================================
        AUTO SLIDE
        ==========================================
        */

        function startAutoSlide() {

            clearInterval(autoSlide);

            autoSlide = setInterval(
                function () {

                    nextSlide();

                },
                6000
            );

        }


        /*
        ==========================================
        RESTART AUTO SLIDE
        ==========================================
        */

        function restartAutoSlide() {

            clearInterval(autoSlide);

            startAutoSlide();

        }


        /*
        ==========================================
        PAUSE WHILE HOVERING
        ==========================================
        */

        if (wrapper) {

            wrapper.addEventListener(
                "mouseenter",
                function () {

                    clearInterval(autoSlide);

                }
            );


            wrapper.addEventListener(
                "mouseleave",
                function () {

                    startAutoSlide();

                }
            );

        }


        /*
        ==========================================
        INITIAL SLIDE
        ==========================================
        */

        goToSlide(0);

        startAutoSlide();

    });
</script>