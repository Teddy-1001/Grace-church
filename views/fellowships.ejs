<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Find an ACK St. Phillips Roadblock Church estate fellowship near you. Join a local group for prayer, Scripture and community.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="shortcut icon" href="/images/ack-logo.svg" type="image/x-icon">
    <title>Estate Fellowships | ACK St. Phillips Roadblock</title>
</head>

<body class="bg-ack-cream text-gray-900 antialiased">
    <%- include('partials/header.ejs') %>

    <main>
        <section class="relative isolate overflow-hidden bg-ack-purple-dark">
            <img src="/images/2019-06-02.jpg" alt="The church community gathered together"
                class="absolute inset-0 -z-20 h-full w-full object-cover opacity-35">
            <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ack-purple-dark via-ack-purple-dark/90 to-ack-purple-dark/50"></div>
            <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
                <div class="max-w-2xl text-white">
                    <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-ack-gold">
                        <i class="fa-solid fa-house-chimney-user" aria-hidden="true"></i>
                        Faith in your neighbourhood
                    </p>
                    <h1 class="mt-4 font-display text-4xl font-bold leading-tight md:text-6xl">
                        Find your fellowship.
                    </h1>
                    <p class="mt-5 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
                        Smaller gatherings, close to home. Meet for prayer, Scripture and genuine community across our neighbourhoods.
                    </p>
                    <a href="#all-fellowships"
                        class="mt-8 inline-flex items-center gap-2 rounded-lg bg-ack-gold px-5 py-3 font-semibold text-ack-purple-dark transition hover:bg-white">
                        Explore our groups
                        <i class="fa-solid fa-arrow-down text-sm" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </section>

        <section class="bg-white">
            <div class="mx-auto grid max-w-7xl gap-6 px-6 py-7 sm:grid-cols-3">
                <div class="flex items-start gap-3">
                    <i class="fa-regular fa-clock mt-1 text-ack-gold" aria-hidden="true"></i>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Most groups meet</p>
                        <p class="mt-1 font-semibold text-ack-purple-dark">Sunday afternoons</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <i class="fa-solid fa-location-dot mt-1 text-ack-gold" aria-hidden="true"></i>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Gathering places</p>
                        <p class="mt-1 font-semibold text-ack-purple-dark">Homes and community spaces</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <i class="fa-solid fa-heart mt-1 text-ack-gold" aria-hidden="true"></i>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Everyone is welcome</p>
                        <p class="mt-1 font-semibold text-ack-purple-dark">Come as you are</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-6 py-16 md:py-20" id="all-fellowships">
            <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-ack-gold">Life in community</p>
                    <h2 class="mt-2 font-display text-3xl font-bold text-ack-purple-dark md:text-4xl">
                        Choose a group near you
                    </h2>
                </div>
                <p class="max-w-md leading-relaxed text-gray-600">
                    Explore the groups below and get in touch to confirm the next meeting place.
                </p>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                <% fellowships.forEach(f => { %>
                    <%- include('partials/fellowship-card.ejs', { f }) %>
                <% }) %>
            </div>

            <div class="mt-12 rounded-2xl bg-ack-purple-dark px-6 py-8 text-white md:flex md:items-center md:justify-between md:px-8">
                <div>
                    <h2 class="font-display text-xl font-bold">Not sure which group to visit?</h2>
                    <p class="mt-2 text-sm leading-relaxed text-white/75">Join us for Sunday worship and we'll help you find a fellowship.</p>
                </div>
                <a href="/services"
                    class="mt-5 inline-flex items-center gap-2 rounded-lg bg-ack-gold px-5 py-3 text-sm font-semibold text-ack-purple-dark transition hover:bg-white md:mt-0">
                    Sunday services
                    <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>
            </div>
        </section>
    </main>

    <%- include('partials/footer.ejs') %>
</body>

</html>
