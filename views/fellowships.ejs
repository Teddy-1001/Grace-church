<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/output.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="shortcut icon" href="/images/ack-logo.svg" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/ack-logo.svg" type="image/x-icon">
    <title>Estate Fellowships | ACK St. Phillips Roadblock</title>
</head>

<body class="bg-ack-cream text-gray-900 antialiased">
    <%- include('partials/header.ejs') %>
        <section class="relative min-h-[70vh] flex items-center overflow-hidden" aria-label="Estate fellowships">
            <div class="fixed inset-0 -z-10">
                <img src="/images/2019-06-02.jpg" class="w-full h-full object-cover scale-105"
                    alt="Fellowship gathering at St. Phillips Roadblock">
            </div>
            <div class="absolute inset-0 bg-ack-purple-dark/25"></div>

            <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 w-full">
                <div class="max-w-2xl text-white">
                    <p class="text-ack-gold text-sm font-semibold uppercase tracking-wider">
                        <i class="fa-solid fa-house-chimney-user mr-1" aria-hidden="true"></i> Neighbourhood Church
                    </p>
                    <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight mt-3">
                        Estate Fellowships
                    </h1>
                    <p class="mt-4 text-white/85 text-lg leading-relaxed">
                        The church in your neighbourhood — home-based groups across Kahoya, Roadblock, and surrounding
                        estates for prayer, Scripture, and mutual care every Sunday afternoon.
                    </p>
                    <div class="mt-8 flex flex-col sm:flex-row gap-4">
                        <a href="#all-fellowships"
                            class="bg-ack-gold text-ack-purple-dark px-6 py-3 rounded-lg font-semibold hover:bg-amber-300 transition text-center">
                            Find Your Group
                        </a>
                        <a href="/src/pages/index.html#worship-schedule"
                            class="border border-white/40 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition text-center">
                            Sunday Services
                        </a>
                        <a href="/ministries"
                            class="border border-white/30 text-white/90 px-6 py-3 rounded-lg font-medium hover:bg-white/10 transition text-center">
                            Parish Ministries
                        </a>
                    </div>
                </div>
            </div>

        </section>

        <section class="bg-ack-purple-dark text-white py-10">
            <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-8 text-center md:text-left text-sm">
                <div>
                    <p class="text-ack-gold font-semibold uppercase text-xs mb-1">When</p>
                    <p class="text-white/90">Sundays, 2:00 – 4:00 PM after main service</p>
                </div>
                <div>
                    <p class="text-ack-gold font-semibold uppercase text-xs mb-1">Where</p>
                    <p class="text-white/90">Homes and halls across member estates</p>
                </div>
                <div>
                    <p class="text-ack-gold font-semibold uppercase text-xs mb-1">Why</p>
                    <p class="text-white/90">Prayer, Bible study, and caring for one another</p>
                </div>
            </div>
        </section>

        <!-- Fellowships grid -->
        <section class="bg-[#eef1f6] py-20 md:py-24" id="all-fellowships">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <span class="text-ack-purple text-sm font-semibold uppercase tracking-wider">Join a Group</span>
                    <h2 class="font-display text-3xl md:text-4xl font-bold text-ack-purple-dark mt-2">
                        Our Estate Groups
                    </h2>
                    <p class="text-gray-600 mt-3">
                        Each fellowship meets near you. Leaders and venues will be updated from the admin panel later.
                    </p>
                </div>
                <div id="fellowship-container" class="grid gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                    <% fellowships.forEach(f => { %>
                        <%- include('partials/fellowship-card.ejs', {f}) %>
                    <% }) %>
                </div>
            </div>
        </section>
        <%- include('partials/footer.ejs') %>

</body>

</html>