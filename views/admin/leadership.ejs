<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Church Leadership | ACK Admin</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-gray-50 text-gray-800">

    <div class="flex min-h-screen">

        <!-- SIDEBAR -->
        <%- include('../partials/admin/sidebar.ejs') %>

        <!-- MAIN CONTENT -->
        <main class="flex-1 min-w-0">

            <!-- TOP HEADER -->
            <header class="h-20 bg-white border-b border-gray-200 flex items-center justify-between px-5 md:px-8">

                <div>
                    <h1 class="text-xl font-bold text-ack-purple">
                        Church Leadership
                    </h1>

                    <p class="text-sm text-gray-500">
                        Manage your church leadership team.
                    </p>
                </div>

                <a href="/"
                    target="_blank"
                    class="hidden sm:flex items-center gap-2 text-sm text-gray-600 hover:text-ack-purple">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    View Website
                </a>

            </header>


            <!-- PAGE CONTENT -->
            <section class="p-5 md:p-8 max-w-7xl mx-auto">

                <!-- PAGE INTRO -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">

                    <div>
                        <h2 class="text-2xl font-bold text-gray-900">
                            Leadership Team
                        </h2>

                        <p class="text-sm text-gray-500 mt-1">
                            Add, update and organize the people serving in church leadership.
                        </p>
                    </div>

                    <button
                        onclick="openLeaderModal()"
                        class="bg-ack-purple hover:bg-ack-purple-dark text-white px-5 py-3 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 transition">

                        <i class="fa-solid fa-plus"></i>
                        Add Leader

                    </button>

                </div>


                <!-- STATISTICS -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">

                    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">

                        <div class="flex items-center justify-between">

                            <div>
                                <p class="text-sm text-gray-500">Total Leaders</p>

                                <h3 class="text-3xl font-bold mt-2">
                                    <%= leaders.length %>
                                </h3>
                            </div>

                            <div class="w-12 h-12 rounded-xl bg-purple-50 text-ack-purple flex items-center justify-center">
                                <i class="fa-solid fa-users text-xl"></i>
                            </div>

                        </div>

                    </div>


                    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">

                        <div class="flex items-center justify-between">

                            <div>
                                <p class="text-sm text-gray-500">Featured Leaders</p>

                                <h3 class="text-3xl font-bold mt-2">
                                    <%= leaders.filter(leader => leader.featured).length %>
                                </h3>
                            </div>

                            <div class="w-12 h-12 rounded-xl bg-yellow-50 text-yellow-600 flex items-center justify-center">
                                <i class="fa-solid fa-star text-xl"></i>
                            </div>

                        </div>

                    </div>


                    <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">

                        <div class="flex items-center justify-between">

                            <div>
                                <p class="text-sm text-gray-500">Active Leaders</p>

                                <h3 class="text-3xl font-bold mt-2">
                                    <%= leaders.filter(leader => leader.is_active !== false).length %>
                                </h3>
                            </div>

                            <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                                <i class="fa-solid fa-user-check text-xl"></i>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- LEADERS TABLE -->
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

                    <!-- TABLE HEADER -->
                    <div class="p-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">

                        <div>
                            <h3 class="font-bold text-gray-900">
                                All Leaders
                            </h3>

                            <p class="text-xs text-gray-500 mt-1">
                                Manage the people displayed on your public leadership page.
                            </p>
                        </div>

                        <div class="relative">

                            <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>

                            <input
                                type="search"
                                id="leaderSearch"
                                placeholder="Search leaders..."
                                class="border border-gray-200 rounded-lg pl-9 pr-4 py-2.5 text-sm outline-none focus:border-ack-purple w-full sm:w-64">

                        </div>

                    </div>


                    <!-- TABLE -->
                    <div class="overflow-x-auto">

                        <table class="w-full text-left">

                            <thead class="bg-gray-50 text-xs uppercase text-gray-500">

                                <tr>
                                    <th class="px-6 py-4">Leader</th>
                                    <th class="px-6 py-4">Position</th>
                                    <th class="px-6 py-4">Category</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4">Featured</th>
                                    <th class="px-6 py-4 text-right">Actions</th>
                                </tr>

                            </thead>


                            <tbody id="leadersTable" class="divide-y divide-gray-100">

                                <% if (leaders.length > 0) { %>

                                    <% leaders.forEach(leader => { %>

                                        <tr class="leader-row hover:bg-gray-50 transition">

                                            <!-- LEADER -->
                                            <td class="px-6 py-4">

                                                <div class="flex items-center gap-3 min-w-48">

                                                    <img
                                                        src="<%= leader.image_url || leader.image || '/images/placeholder.jpg' %>"
                                                        alt="<%= leader.name %>"
                                                        class="w-11 h-11 rounded-full object-cover bg-gray-100">

                                                    <div>
                                                        <p class="font-semibold text-sm text-gray-900">
                                                            <%= leader.name %>
                                                        </p>

                                                        <p class="text-xs text-gray-500">
                                                            <%= leader.email || leader.phone || 'No contact information' %>
                                                        </p>
                                                    </div>

                                                </div>

                                            </td>


                                            <!-- POSITION -->
                                            <td class="px-6 py-4 text-sm text-gray-600">
                                                <%= leader.position %>
                                            </td>


                                            <!-- CATEGORY -->
                                            <td class="px-6 py-4">

                                                <span class="px-3 py-1 rounded-full text-xs bg-purple-50 text-ack-purple">
                                                    <%= leader.category %>
                                                </span>

                                            </td>


                                            <!-- STATUS -->
                                            <td class="px-6 py-4">

                                                <% if (leader.is_active !== false) { %>

                                                    <span class="text-xs font-medium text-green-700 bg-green-50 px-3 py-1 rounded-full">
                                                        Active
                                                    </span>

                                                <% } else { %>

                                                    <span class="text-xs font-medium text-gray-600 bg-gray-100 px-3 py-1 rounded-full">
                                                        Inactive
                                                    </span>

                                                <% } %>

                                            </td>


                                            <!-- FEATURED -->
                                            <td class="px-6 py-4">

                                                <% if (leader.featured) { %>

                                                    <span class="text-yellow-600 text-sm">
                                                        <i class="fa-solid fa-star"></i> Yes
                                                    </span>

                                                <% } else { %>

                                                    <span class="text-gray-400 text-sm">
                                                        No
                                                    </span>

                                                <% } %>

                                            </td>


                                            <!-- ACTIONS -->
                                            <td class="px-6 py-4">

                                                <div class="flex items-center justify-end gap-3">

                                                    <a
                                                        href="/admin/leadership/<%= leader.id %>/edit"
                                                        class="text-blue-600 hover:text-blue-800"
                                                        title="Edit leader">

                                                        <i class="fa-solid fa-pen-to-square"></i>

                                                    </a>

                                                    <form
                                                        action="/admin/leadership/<%= leader.id %>/delete"
                                                        method="POST"
                                                        onsubmit="return confirm('Are you sure you want to delete this leader?')">

                                                        <button
                                                            type="submit"
                                                            class="text-red-500 hover:text-red-700"
                                                            title="Delete leader">

                                                            <i class="fa-solid fa-trash"></i>

                                                        </button>

                                                    </form>

                                                </div>

                                            </td>

                                        </tr>

                                    <% }) %>

                                <% } else { %>

                                    <tr>
                                        <td colspan="6" class="text-center py-16">

                                            <i class="fa-solid fa-users text-4xl text-gray-200"></i>

                                            <p class="font-semibold mt-3 text-gray-600">
                                                No leaders added yet
                                            </p>

                                            <p class="text-sm text-gray-400 mt-1">
                                                Add your first church leader to get started.
                                            </p>

                                        </td>
                                    </tr>

                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </main>

    </div>


    <!-- ADD LEADER MODAL -->
    <div
        id="leaderModal"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">

        <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl">

            <!-- MODAL HEADER -->
            <div class="p-6 border-b border-gray-100 flex items-center justify-between">

                <div>
                    <h3 class="text-xl font-bold text-gray-900">
                        Add Church Leader
                    </h3>

                    <p class="text-sm text-gray-500 mt-1">
                        Enter the leader's information below.
                    </p>
                </div>

                <button
                    onclick="closeLeaderModal()"
                    class="w-9 h-9 rounded-full hover:bg-gray-100 text-gray-500">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>


            <!-- FORM -->
            <form action="/admin/leadership" method="POST" class="p-6 space-y-5">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                    <!-- NAME -->
                    <div>
                        <label class="block text-sm font-semibold mb-2">
                            Full Name *
                        </label>

                        <input
                            type="text"
                            name="name"
                            required
                            placeholder="Enter full name"
                            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple">
                    </div>


                    <!-- POSITION -->
                    <div>
                        <label class="block text-sm font-semibold mb-2">
                            Position *
                        </label>

                        <input
                            type="text"
                            name="position"
                            required
                            placeholder="e.g. Vicar"
                            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple">
                    </div>


                    <!-- CATEGORY -->
                    <div>
                        <label class="block text-sm font-semibold mb-2">
                            Category *
                        </label>

                        <select
                            name="category"
                            required
                            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple">

                            <option value="">Select category</option>
                            <option value="Clergy">Clergy</option>
                            <option value="Administration">Administration</option>
                            <option value="Church Leadership">Church Leadership</option>
                            <option value="Ministry Leadership">Ministry Leadership</option>

                        </select>
                    </div>


                    <!-- PHONE -->
                    <div>
                        <label class="block text-sm font-semibold mb-2">
                            Phone Number
                        </label>

                        <input
                            type="tel"
                            name="phone"
                            placeholder="+254..."
                            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple">
                    </div>


                    <!-- EMAIL -->
                    <div>
                        <label class="block text-sm font-semibold mb-2">
                            Email Address
                        </label>

                        <input
                            type="email"
                            name="email"
                            placeholder="leader@example.com"
                            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple">
                    </div>


                    <!-- IMAGE URL -->
                    <div>
                        <label class="block text-sm font-semibold mb-2">
                            Profile Image URL
                        </label>

                        <input
                            type="url"
                            name="image_url"
                            placeholder="https://..."
                            class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple">
                    </div>

                </div>


                <!-- BIO -->
                <div>
                    <label class="block text-sm font-semibold mb-2">
                        Biography
                    </label>

                    <textarea
                        name="bio"
                        rows="4"
                        placeholder="Write a short biography..."
                        class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm outline-none focus:border-ack-purple"></textarea>
                </div>


                <!-- OPTIONS -->
                <div class="flex flex-wrap gap-6">

                    <label class="flex items-center gap-2 text-sm text-gray-600">
                        <input type="checkbox" name="featured" value="true"
                            class="accent-ack-purple w-4 h-4">

                        Feature on website
                    </label>

                    <label class="flex items-center gap-2 text-sm text-gray-600">
                        <input type="checkbox" name="is_active" value="true" checked
                            class="accent-ack-purple w-4 h-4">

                        Active
                    </label>

                </div>


                <!-- BUTTONS -->
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">

                    <button
                        type="button"
                        onclick="closeLeaderModal()"
                        class="px-5 py-3 rounded-lg text-sm font-semibold text-gray-600 hover:bg-gray-100">

                        Cancel

                    </button>

                    <button
                        type="submit"
                        class="px-6 py-3 rounded-lg bg-ack-purple text-white text-sm font-semibold hover:bg-ack-purple-dark">

                        <i class="fa-solid fa-plus mr-1"></i>
                        Save Leader

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- JAVASCRIPT -->
    <script>

        // OPEN MODAL
        function openLeaderModal() {
            const modal = document.getElementById("leaderModal");

            modal.classList.remove("hidden");
            modal.classList.add("flex");
        }


        // CLOSE MODAL
        function closeLeaderModal() {
            const modal = document.getElementById("leaderModal");

            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }


        // SEARCH LEADERS
        document.getElementById("leaderSearch").addEventListener("input", function () {

            const searchValue = this.value.toLowerCase();

            document.querySelectorAll(".leader-row").forEach(row => {

                const rowText = row.textContent.toLowerCase();

                row.style.display = rowText.includes(searchValue) ? "" : "none";

            });

        });


        // CLOSE MODAL WHEN CLICKING OUTSIDE
        document.getElementById("leaderModal").addEventListener("click", function (event) {

            if (event.target === this) {
                closeLeaderModal();
            }

        });

    </script>

</body>
</html>