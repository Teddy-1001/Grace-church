<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>Church Leadership | ACK St. Phillips Roadblock</title>

<meta name="description"
    content="Meet the church leaders of ACK St. Phillips Roadblock, Eldoret, and discover the people serving our congregation through faith and leadership.">

<link rel="stylesheet" href="/css/output.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

</head>

<body class="bg-white">


<%- include("partials/header") %>

<main>

    <!-- HERO SECTION -->
    <section class="relative bg-ack-purple text-white overflow-hidden">

        <div class="absolute inset-0 opacity-10">
            <div class="absolute -top-32 -right-20 w-96 h-96 border border-white rounded-full"></div>
            <div class="absolute -bottom-40 -left-20 w-[500px] h-[500px] border border-white rounded-full"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-6 md:px-8 py-24 md:py-32">

            <div class="max-w-3xl">

                <div class="flex items-center gap-3 text-xs text-white/60 mb-8 uppercase tracking-widest">
                    <a href="/" class="hover:text-ack-gold transition">Home</a>
                    <i class="fa-solid fa-chevron-right text-[9px]"></i>
                    <span class="text-ack-gold">Leadership</span>
                </div>

                <p class="text-ack-gold uppercase tracking-[0.3em] text-xs font-semibold mb-6">
                    Called to Serve
                </p>

                <h1 class="font-display text-5xl md:text-7xl leading-tight font-bold mb-8">
                    Leading with<br>
                    <span class="text-ack-gold italic">Faith & Purpose.</span>
                </h1>

                <p class="text-white/70 text-base md:text-lg leading-8 max-w-2xl">
                    Meet the people entrusted with guiding our church family.
                    Together, we serve, inspire, nurture faith, and strengthen
                    our community through the love of Christ.
                </p>

                <div class="flex flex-wrap gap-4 mt-10">

                    <a href="#our-leaders"
                        class="inline-flex items-center gap-3 bg-ack-gold text-ack-purple px-7 py-4 rounded-full text-sm font-semibold hover:bg-white transition duration-300">
                        Meet Our Leaders
                        <i class="fa-solid fa-arrow-down text-xs"></i>
                    </a>

                    <a href="/#contact"
                        class="inline-flex items-center gap-3 border border-white/25 text-white px-7 py-4 rounded-full text-sm font-medium hover:bg-white/10 transition duration-300">
                        Get in Touch
                    </a>

                </div>

            </div>

        </div>

        <div class="absolute bottom-0 left-0 w-full h-1 bg-ack-gold/70"></div>

    </section>


    <!-- INTRODUCTION -->
    <section class="py-20 md:py-28 px-6 bg-ack-cream">

        <div class="max-w-4xl mx-auto text-center">

            <span class="inline-block text-ack-purple uppercase tracking-[0.25em] text-xs font-semibold mb-5">
                Our Church Family
            </span>

            <h2 class="font-display text-3xl md:text-5xl text-ack-purple leading-tight mb-7">
                Leadership is a calling.<br>
                <span class="italic text-ack-purple/65">Service is our commitment.</span>
            </h2>

            <p class="text-gray-600 text-base md:text-lg leading-8 max-w-3xl mx-auto">
                At ACK St. Phillips Roadblock, we believe that true leadership
                begins with a heart for service. Our leaders work together to
                build a welcoming church, encourage spiritual growth, and
                support the mission of spreading God's love.
            </p>

            <div class="w-16 h-1 bg-ack-gold mx-auto mt-9 rounded-full"></div>

        </div>

    </section>


    <!-- LEADERSHIP PROFILES -->
    <section id="our-leaders" class="py-20 md:py-28 px-6">

        <div class="max-w-7xl mx-auto">

            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">

                <div>
                    <p class="text-ack-gold uppercase tracking-[0.25em] text-xs font-semibold mb-4">
                        The People Behind Our Mission
                    </p>

                    <h2 class="font-display text-3xl md:text-5xl text-ack-purple">
                        Our Church Leaders
                    </h2>
                </div>

                <p class="text-gray-500 text-sm leading-7 max-w-md">
                    Dedicated individuals serving our congregation
                    with humility, commitment, and faith.
                </p>

            </div>


            <!-- FEATURED LEADERS -->
            <% if (featuredLeaders && featuredLeaders.length) { %>

                <div class="grid md:grid-cols-2 gap-8 mb-20">

                    <% featuredLeaders.forEach(leader => { %>

                        <article class="group bg-ack-cream rounded-3xl overflow-hidden grid sm:grid-cols-2">

                            <div class="relative min-h-[300px] sm:min-h-[380px] overflow-hidden">

                                <img
                                    src="<%= leader.image %>"
                                    alt="<%= leader.name %>"
                                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-700"
                                    loading="lazy"
                                >

                                <div class="absolute inset-0 bg-gradient-to-t from-ack-purple/30 to-transparent"></div>

                            </div>

                            <div class="p-7 md:p-8 flex flex-col justify-center">

                                <span class="text-ack-gold uppercase tracking-[0.2em] text-[10px] font-bold mb-4">
                                    <%= leader.category %>
                                </span>

                                <h3 class="font-display text-2xl md:text-3xl text-ack-purple font-semibold leading-tight">
                                    <%= leader.name %>
                                </h3>

                                <p class="text-ack-purple/60 text-sm font-medium mt-2">
                                    <%= leader.position %>
                                </p>

                                <div class="w-10 h-0.5 bg-ack-gold my-5"></div>

                                <p class="text-gray-600 text-sm leading-7">
                                    <%= leader.bio %>
                                </p>

                                <% if (leader.phone) { %>
                                    <a href="tel:<%= leader.phone.replace(/\s/g, '') %>"
                                        class="inline-flex items-center gap-2 text-ack-purple text-sm font-semibold mt-6 hover:text-ack-gold transition">
                                        <i class="fa-solid fa-phone text-xs"></i>
                                        Contact
                                    </a>
                                <% } %>

                            </div>

                        </article>

                    <% }) %>

                </div>

            <% } %>


            <!-- OTHER LEADERS -->
            <% if (otherLeaders && otherLeaders.length) { %>

                <div class="mb-10">

                    <p class="text-ack-gold uppercase tracking-[0.25em] text-xs font-semibold mb-3">
                        Serving Together
                    </p>

                    <h3 class="font-display text-2xl md:text-3xl text-ack-purple">
                        Ministry & Administration
                    </h3>

                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

                    <% otherLeaders.forEach(leader => { %>

                        <article class="group">

                            <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-ack-cream">

                                <img
                                    src="<%= leader.image %>"
                                    alt="<%= leader.name %>"
                                    class="w-full h-full object-cover group-hover:scale-105 transition duration-700"
                                    loading="lazy"
                                >

                                <div class="absolute inset-0 bg-gradient-to-t from-ack-purple/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition duration-500"></div>

                            </div>

                            <div class="pt-5">

                                <p class="text-ack-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-2">
                                    <%= leader.category %>
                                </p>

                                <h4 class="font-display text-xl text-ack-purple font-semibold">
                                    <%= leader.name %>
                                </h4>

                                <p class="text-gray-500 text-sm mt-1">
                                    <%= leader.position %>
                                </p>

                                <p class="text-gray-600 text-sm leading-7 mt-4">
                                    <%= leader.bio %>
                                </p>

                                <% if (leader.phone) { %>
                                    <a href="tel:<%= leader.phone.replace(/\s/g, '') %>"
                                        class="inline-flex items-center gap-2 text-ack-purple text-xs font-semibold mt-4 hover:text-ack-gold transition">
                                        <i class="fa-solid fa-phone"></i>
                                        Contact
                                    </a>
                                <% } %>

                            </div>

                        </article>

                    <% }) %>

                </div>

            <% } %>

        </div>

    </section>


    <!-- CLOSING CTA -->
    <section class="bg-ack-cream px-6 py-20">

        <div class="max-w-5xl mx-auto bg-ack-purple rounded-3xl px-8 py-14 md:px-16 text-center relative overflow-hidden">

            <div class="absolute -top-20 -right-20 w-64 h-64 border border-white/10 rounded-full"></div>
            <div class="absolute -bottom-24 -left-16 w-72 h-72 border border-white/10 rounded-full"></div>

            <div class="relative">

                <p class="text-ack-gold uppercase tracking-[0.25em] text-xs font-semibold mb-5">
                    Growing Together in Faith
                </p>

                <h2 class="font-display text-3xl md:text-4xl text-white mb-6">
                    There is a place for you here.
                </h2>

                <p class="text-white/65 max-w-2xl mx-auto leading-7 mb-9">
                    We welcome you to worship, fellowship, and grow with
                    our church family. Come and be part of what God is doing
                    in our community.
                </p>

                <a href="/#contact"
                    class="inline-flex items-center gap-3 bg-ack-gold text-ack-purple px-8 py-4 rounded-full text-sm font-semibold hover:bg-white transition duration-300">
                    Visit Our Church
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>

            </div>

        </div>

    </section>

</main>

<%- include("partials/footer") %>


</body>

</html>
