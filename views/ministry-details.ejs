<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <!-- Character encoding -->
    <meta charset="UTF-8">

    <!-- Responsive layout -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Page title -->
    <title>Ministry | ACK St. Phillips Roadblock</title>

    <!-- SEO description -->
    <meta
        name="description"
        content="Discover the guilds and ministries at ACK St. Phillips Roadblock, including KAMA, Mothers' Union, KAYO, Sunday School, choir, vergers, and more."
    >

    <!-- Website theme -->
    <meta name="theme-color" content="#ffffff">

    <!-- Font Awesome icons -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    >

    <!-- Compiled Tailwind CSS -->
    <link rel="stylesheet" href="/css/output.css">

    <!-- Website favicon -->
    <link
        rel="icon"
        href="/images/ack-logo.svg"
        type="image/svg+xml"
    >
</head>

<body class="bg-ack-cream text-gray-900 antialiased">
    <%- include('partials/header.ejs') %>
        <main id="ministry-detail" class="min-h-[60vh]">

            <section class="relative min-h-[42vh] flex items-end overflow-hidden">
                <img src="<%= ministry.image %>" alt="" class="absolute inset-0 w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-ack-purple-dark via-ack-purple/25 to-transparent">
                </div>
                <div class="relative z-10 max-w-7xl mx-auto px-6 pb-12 pt-32 w-full text-white">
                    <a href="/ministries"
                        class="inline-flex items-center gap-2 text-white/80 hover:text-ack-gold text-sm mb-4 transition">
                        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All ministries
                    </a>
                    <div class="flex flex-wrap gap-2 mb-3">
                        <span class="<%= ministry.badgeClass %> text-xs px-3 py-1 rounded-full font-semibold">
                            <%= ministry.type %>
                        </span>
                    </div>
                    <h1 class="font-display text-3xl md:text-5xl font-bold">
                        <%= ministry.name %>
                    </h1>
                </div>
            </section>
            <!-- <div class="max-w-7xl mx-auto px-6 py-16 text-center text-gray-500">

            </div> -->
            <section class="max-w-7xl mx-auto px-6 py-12 md:py-16">
                <div class="grid lg:grid-cols-3 gap-10">
                    <div class="lg:col-span-2">
                        <h2 class="text-sm font-semibold text-ack-purple uppercase tracking-wider">About this ministry
                        </h2>
                        <p class="text-gray-700 mt-3 leading-relaxed text-lg">
                            <%= ministry.description %>
                        </p>
                        <p class="text-gray-600 mt-4 text-sm leading-relaxed">
                            <%= ministry.membership %>
                        </p>
                        <section class="mt-10">
                            <h2
                                class="text-sm font-semibold text-ack-purple uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-hands-holding-heart text-ack-gold" aria-hidden="true"></i> What we
                                do
                            </h2>
                            <ul class="mt-4 space-y-2">
                                <% ministry.activities.map((item)=> { %>
                                    <li class="flex gap-2 text-gray-700 text-sm leading-relaxed"><i
                                            class="fa-solid fa-check text-ack-gold mt-1 shrink-0"
                                            aria-hidden="true"></i>
                                        <span>
                                            <%= item %>
                                        </span>
                                    </li>
                                    <% }) %>

                            </ul>
                        </section>

                        <section class="mt-10">
                            <h2
                                class="text-sm font-semibold text-ack-purple uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-calendar-days text-ack-gold" aria-hidden="true"></i> Weekly
                                schedule
                            </h2>
                            <div class="mt-4 space-y-3">
                                <% ministry.schedule.map((item)=> { %>
                                    <div
                                        class="bg-white border border-gray-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
                                        <span class="text-xs font-bold text-ack-purple uppercase shrink-0 w-28">
                                            <%= item.day %>
                                        </span>
                                        <span class="text-sm font-semibold text-gray-900 shrink-0">
                                            <%= item.time %>
                                        </span>
                                        <span class="text-sm text-gray-600">
                                            <%= item.activities %>
                                        </span>
                                    </div>
                                    <% }) %>
                            </div>
                        </section>

                        <section class="mt-10">
                            <h2
                                class="text-sm font-semibold text-ack-purple uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-hand-holding-dollar text-ack-gold" aria-hidden="true"></i> Giving
                                &amp; payments
                            </h2>
                            <p class="text-gray-600 text-sm mt-2 leading-relaxed">
                                Support this group’s programmes through the channels below. Always include your
                                <strong>name</strong> and
                                <strong>ministry/fellowship</strong> in the M-Pesa message.
                            </p>
                            <div class="mt-4 grid sm:grid-cols-2 gap-4">
                                <% ministry.payments.map((p)=> { %>
                                    <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
                                        <p class="font-semibold text-ack-purple-dark text-sm">
                                            <%= p.title %>
                                        </p>
                                        <p class="text-2xl font-bold text-gray-900 mt-1">
                                            <%= p.amount %>
                                        </p>
                                        <p class="text-sm text-gray-700 mt-3"><i
                                                class="fa-solid fa-mobile-screen text-green-600 mr-1"
                                                aria-hidden="true"></i><strong>M-Pesa:</strong>
                                            <%= p.mpesa %>
                                        </p>
                                        <p class="text-xs text-gray-500 mt-2">
                                            <%= p.notes %>
                                        </p>
                                    </div>
                                    <% }) %>
                            </div>
                        </section>
                    </div>
                    <aside class="space-y-6 lg:sticky lg:top-24 h-fit">
                        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
                            <h2 class="font-semibold text-ack-purple-dark">Meeting details</h2>
                            <ul class="mt-4 space-y-4 text-sm text-gray-700">
                                ${meeting
                                .map(
                                (m) => `
                                <li class="flex gap-3">
                                    <i class="fa-solid fa-${m.icon} text-ack-gold mt-0.5" aria-hidden="true"></i>
                                    <span><strong class="text-gray-900">${esc(m.label)}</strong><br>${m.html ||
                                        esc(m.value)}</span>
                                </li>
                                `
                                )
                                .join("")}
                            </ul>
                        </div>
                       <div class="bg-ack-purple text-white rounded-2xl p-6">
    <h3 class="font-semibold text-ack-gold text-sm uppercase">
        Parish office
    </h3>

    <p class="text-white/85 text-sm mt-2 leading-relaxed">
        <%= contacts.officeHours %>
    </p>

    <ul class="mt-3 text-sm space-y-2 text-white/90">
        <li>
            <a href="tel:<%= contacts.phone.replace(/\s/g, '') %>"
               class="hover:text-ack-gold">
                <%= contacts.phone %>
            </a>
        </li>

        <li>
            <a href="mailto:<%= contacts.email %>"
               class="hover:text-ack-gold break-all">
                <%= contacts.email %>
            </a>
        </li>
    </ul>
</div>
                        
                        ${(extraLinks || [])
                        <!-- .map(
                        (l) => `
                        <a href="${l.href}" class="block text-center ${l.primary ? " bg-ack-gold text-ack-purple-dark
                            font-semibold"
                            : "border-2 border-ack-purple text-ack-purple font-semibold hover:bg-ack-purple/5" } py-3
                            rounded-lg text-sm transition">
                            ${esc(l.label)}
                        </a>
                        `
                        ) -->
                        .join("")}
                    </aside>
                </div>
            </section>
        </main>
</body>

</html>